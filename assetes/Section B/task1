Write a Dart console program that takes food order details and prints a formattedconfirmation message with a delivery tier and order status label.


void main() {
  int orderId = 101;
  String customerName = "Riddhi";
  int numberOfItems = 3;
  double totalAmount = 650.0;
  int statusCode = 1;

  // Order confirmation
  print("===== Order Confirmation =====");
  print("Order ID: $orderId");
  print("Customer Name: $customerName");
  print("Number of Items: $numberOfItems");
  print("Total Amount: Rs. $totalAmount");

  // Delivery tier
  if (totalAmount > 500) {
    print("Delivery Tier: Express Delivery");
  } else {
    print("Delivery Tier: Standard Delivery");
  }

  // Order status
  switch (statusCode) {
    case 1:
      print("Order Status: Preparing");
      break;
    case 2:
      print("Order Status: Out for Delivery");
      break;
    case 3:
      print("Order Status: Delivered");
      break;
    default:
      print("Order Status: Invalid Status");
  }
}
