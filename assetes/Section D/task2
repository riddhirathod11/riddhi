import 'package:flutter/material.dart';

void main() => runApp(const MaterialApp(
  home: OrderScreen(),
  debugShowCheckedModeBanner: false,
));

class FoodItem {
  final String name;
  final int quantity;
  final double price;

  const FoodItem(this.name, this.quantity, this.price);
}

class OrderScreen extends StatefulWidget {
  const OrderScreen({super.key});

  @override
  State<OrderScreen> createState() => _OrderScreenState();
}

class _OrderScreenState extends State<OrderScreen> {
  final List<FoodItem> items = [
    FoodItem('Pizza', 2, 150),
    FoodItem('Burger', 1, 80),
    FoodItem('Pasta', 2, 120),
  ];

  bool placed = false;

  @override
  Widget build(BuildContext context) {
    double total = items.fold(
      0.0,
      (sum, item) => sum + item.quantity * item.price,
    );

    return Scaffold(
      appBar: AppBar(title: const Text('QuickBite Cart')),
      body: items.isEmpty
          ? const Center(child: Text('Your cart is empty'))
          : Column(
              children: [
                Expanded(
                  child: ListView.builder(
                    itemCount: items.length,
                    itemBuilder: (context, index) {
                      final item = items[index];
                      return ListTile(
                        title: Text(item.name),
                        subtitle: Text(
                          'Quantity: ${item.quantity} | '
                          'Unit Price: Rs. ${item.price}',
                        ),
                      );
                    },
                  ),
                ),
                Text('Total: Rs. ${total.toStringAsFixed(2)}'),
                ElevatedButton(
                  onPressed: placed ? null : () {
                    setState(() => placed = true);
                  },
                  child: const Text('Place Order'),
                ),
                Text(placed ? 'Order Placed ›' : 'Order Pending'),
              ],
            ),
    );
  }
}
