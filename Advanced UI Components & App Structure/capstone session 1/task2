2.Add three tabs (e.g., 'Trending', 'Favorites', 'Nearby') inside a single screen using Flutter's TabBar and TabBarView widgets, and display a different icon
and text in each tab to simulate a BookMyShow or Spotify-style tabbed interface.


import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Tabbed Interface',
      theme: ThemeData(
        primarySwatch: Colors.deepOrange,
      ),
      home: const TabScreen(),
    );
  }
}

class TabScreen extends StatelessWidget {
  const TabScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 3,
      child: Scaffold(
        appBar: AppBar(
          title: const Text('Explore'),
          centerTitle: true,
          bottom: const TabBar(
            tabs: [
              Tab(
                icon: Icon(Icons.trending_up),
                text: 'Trending',
              ),
              Tab(
                icon: Icon(Icons.favorite),
                text: 'Favorites',
              ),
              Tab(
                icon: Icon(Icons.location_on),
                text: 'Nearby',
              ),
            ],
          ),
        ),

        body: const TabBarView(
          children: [
            TabContent(
              icon: Icons.trending_up,
              title: 'Trending',
              description: 'Explore what is popular right now!',
              color: Colors.deepOrange,
            ),
            TabContent(
              icon: Icons.favorite,
              title: 'Favorites',
              description: 'Find all your favorite items here.',
              color: Colors.pink,
            ),
            TabContent(
              icon: Icons.location_on,
              title: 'Nearby',
              description: 'Discover places near your location.',
              color: Colors.blue,
            ),
          ],
        ),
      ),
    );
  }
}

class TabContent extends StatelessWidget {
  final IconData icon;
  final String title;
  final String description;
  final Color color;

  const TabContent({
    super.key,
    required this.icon,
    required this.title,
    required this.description,
    required this.color,
  });

  @override
  Widget build(BuildContext context) {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            icon,
            size: 90,
            color: color,
          ),
          const SizedBox(height: 20),
          Text(
            title,
            style: const TextStyle(
              fontSize: 26,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(height: 10),
          Text(
            description,
            textAlign: TextAlign.center,
            style: const TextStyle(fontSize: 16),
          ),
        ],
      ),
    );
  }
}
