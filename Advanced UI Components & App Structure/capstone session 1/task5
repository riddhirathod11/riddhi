import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Service App',
      theme: ThemeData(
        primarySwatch: Colors.deepOrange,
      ),
      home: const HomeScreen(),
    );
  }
}

// Service Data
final List<Map<String, dynamic>> services = [
  {
    'name': 'Food',
    'icon': Icons.restaurant,
    'description': 'Order delicious food from your favorite restaurants.',
  },
  {
    'name': 'Travel',
    'icon': Icons.flight,
    'description': 'Explore beautiful places and plan your next trip.',
  },
  {
    'name': 'Shopping',
    'icon': Icons.shopping_bag,
    'description': 'Shop for clothes, accessories and more.',
  },
  {
    'name': 'Entertainment',
    'icon': Icons.movie,
    'description': 'Discover movies, shows and entertainment.',
  },
  {
    'name': 'Payments',
    'icon': Icons.payment,
    'description': 'Make easy and secure digital payments.',
  },
  {
    'name': 'Sports',
