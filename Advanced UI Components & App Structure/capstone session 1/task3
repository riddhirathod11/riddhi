3.Add an Explore tab that uses a GridView to show at least 6 different categories of services (like Food, Travel, Shopping, Entertainment, Payments, Sports), 
each with an image and label.


import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Explore Categories',
      theme: ThemeData(
        primarySwatch: Colors.deepOrange,
      ),
      home: const ExploreScreen(),
    );
  }
}

class ExploreScreen extends StatelessWidget {
  const ExploreScreen({super.key});

  final List<Map<String, String>> categories = const [
    {
      'name': 'Food',
      'image': 'https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=300',
    },
    {
      'name': 'Travel',
      'image': 'https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=300',
    },
    {
      'name': 'Shopping',
      'image': 'https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=300',
    },
    {
      'name': 'Entertainment',
      'image': 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=300',
    },
    {
      'name': 'Payments',
      'image': 'https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=300',
    },
    {
      'name': 'Sports',
      'image': 'https://images.unsplash.com/photo-1461896836934-ffe607ba8211?w=300',
    },
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Explore'),
        centerTitle: true,
        backgroundColor: Colors.deepOrange,
        foregroundColor: Colors.white,
      ),

      body: Padding(
        padding: const EdgeInsets.all(12),

        child: GridView.builder(
          itemCount: categories.length,
          gridDelegate:
              const SliverGridDelegateWithFixedCrossAxisCount(
            crossAxisCount: 2,
            crossAxisSpacing: 12,
            mainAxisSpacing: 12,
            childAspectRatio: 0.85,
          ),

          itemBuilder: (context, index) {
            return Card(
              elevation: 4,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(12),
              ),

              child: Column(
                children: [
                  Expanded(
                    child: ClipRRect(
                      borderRadius: const BorderRadius.vertical(
                        top: Radius.circular(12),
                      ),

                      child: Image.network(
                        categories[index]['image']!,
                        width: double.infinity,
                        fit: BoxFit.cover,
                        errorBuilder: (context, error, stackTrace) {
                          return const Center(
                            child: Icon(Icons.image_not_supported),
                          );
                        },
                      ),
                    ),
                  ),

                  Padding(
                    padding: const EdgeInsets.all(12),
                    child: Text(
                      categories[index]['name']!,
                      style: const TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              ),
            );
          },
        ),
      ),
    );
  }
}
