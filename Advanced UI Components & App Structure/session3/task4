4.Refactor an existing ListView.builder-based chat list (showing sender and last message) to use ListView.separated, adding a subtle grey divider between each 
chat for better readability.


import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        primarySwatch: Colors.green,
      ),
      home: const ChatScreen(),
    );
  }
}

// Chat Model
class Chat {
  final String sender;
  final String message;
  final String time;

  const Chat({
    required this.sender,
    required this.message,
    required this.time,
  });
}

// Chat Screen
class ChatScreen extends StatelessWidget {
  const ChatScreen({super.key});

  final List<Chat> chats = const [
    Chat(
      sender: 'Rahul',
      message: 'Hello! How are you?',
      time: '10:30 AM',
    ),
    Chat(
      sender: 'Priya',
      message: 'Are you coming today?',
      time: '10:15 AM',
    ),
    Chat(
      sender: 'Amit',
      message: 'Send me the Flutter code.',
      time: '09:45 AM',
    ),
    Chat(
      sender: 'Neha',
      message: 'Thank you so much!',
      time: 'Yesterday',
    ),
    Chat(
      sender: 'Karan',
      message: 'Let us meet tomorrow.',
      time: 'Yesterday',
    ),
    Chat(
      sender: 'Sneha',
      message: 'Good morning!',
      time: 'Yesterday',
    ),
    Chat(
      sender: 'Jay',
      message: 'Assignment completed.',
      time: 'Monday',
    ),
    Chat(
      sender: 'Anjali',
      message: 'See you soon!',
      time: 'Monday',
    ),
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.white,
      appBar: AppBar(
        title: const Text('Chats'),
        backgroundColor: Colors.green,
        foregroundColor: Colors.white,
      ),

      body: ListView.separated(
        itemCount: chats.length,

        // Divider between chats
        separatorBuilder: (context, index) {
          return const Divider(
            color: Colors.grey,
            thickness: 0.5,
            height: 1,
            indent: 75,
          );
        },

        // Chat List Items
        itemBuilder: (context, index) {
          final chat = chats[index];

          return ListTile(
            contentPadding: const EdgeInsets.symmetric(
              horizontal: 15,
              vertical: 5,
            ),

            leading: CircleAvatar(
              radius: 25,
              backgroundColor: Colors.green.shade100,
              child: Text(
                chat.sender[0],
                style: const TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                  color: Colors.green,
                ),
              ),
            ),

            title: Text(
              chat.sender,
              style: const TextStyle(
                fontSize: 17,
                fontWeight: FontWeight.bold,
              ),
            ),

            subtitle: Text(
              chat.message,
              maxLines: 1,
              overflow: TextOverflow.ellipsis,
              style: const TextStyle(
                color: Colors.grey,
                fontSize: 14,
              ),
            ),

            trailing: Text(
              chat.time,
              style: const TextStyle(
                color: Colors.grey,
                fontSize: 12,
              ),
            ),
          );
        },
      ),
    );
  }
}
