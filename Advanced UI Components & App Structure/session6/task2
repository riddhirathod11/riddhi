2.Modify your PlaylistScreen so that when you switch between tabs, the scroll position of each list is preserved and does not reset.
<br><br><em><strong>Hint:</strong> Use AutomaticKeepAliveClientMixin to maintain state for each tab view.</em>


import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: PlaylistScreen(),
    );
  }
}

// Playlist Screen
class PlaylistScreen extends StatelessWidget {
  const PlaylistScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return DefaultTabController(
      length: 2,
      child: Scaffold(
        appBar: AppBar(
          title: const Text("My Music"),
          centerTitle: true,
          backgroundColor: Colors.blue,
          foregroundColor: Colors.white,

          bottom: const TabBar(
            indicatorColor: Colors.white,
            labelColor: Colors.white,
            unselectedLabelColor: Colors.white70,
            tabs: [
              Tab(text: "My Playlists"),
              Tab(text: "Liked Songs"),
            ],
          ),
        ),

        body: const TabBarView(
          children: [
            MyPlaylistsTab(),
            LikedSongsTab(),
          ],
        ),
      ),
    );
  }
}

// My Playlists Tab
class MyPlaylistsTab extends StatefulWidget {
  const MyPlaylistsTab({super.key});

  @override
  State<MyPlaylistsTab> createState() => _MyPlaylistsTabState();
}

class _MyPlaylistsTabState extends State<MyPlaylistsTab>
    with AutomaticKeepAliveClientMixin {

  final List<String> songs = [
    "Perfect - Ed Sheeran",
    "Shape of You - Ed Sheeran",
    "Believer - Imagine Dragons",
    "Faded - Alan Walker",
    "Let Me Love You - DJ Snake",
    "Closer - The Chainsmokers",
    "Senorita - Shawn Mendes",
    "Memories - Maroon 5",
    "Photograph - Ed Sheeran",
    "Happier - Marshmello",
  ];

  @override
  bool get wantKeepAlive => true;

  @override
  Widget build(BuildContext context) {
    super.build(context);

    return ListView.builder(
      key: const PageStorageKey('my_playlists'),
      itemCount: songs.length,
      itemBuilder: (context, index) {
        return Card(
          margin: const EdgeInsets.all(8),
          child: ListTile(
            leading: const Icon(
              Icons.music_note,
              color: Colors.blue,
            ),
            title: Text(songs[index]),
            trailing: const Icon(Icons.play_arrow),
          ),
        );
      },
    );
  }
}

// Liked Songs Tab
class LikedSongsTab extends StatefulWidget {
  const LikedSongsTab({super.key});

  @override
  State<LikedSongsTab> createState() => _LikedSongsTabState();
}

class _LikedSongsTabState extends State<LikedSongsTab>
    with AutomaticKeepAliveClientMixin {

  final List<String> songs = [
    "Night Changes - One Direction",
    "Memories - Maroon 5",
    "Love Yourself - Justin Bieber",
    "Until I Found You - Stephen Sanchez",
    "Dandelions - Ruth B.",
    "Perfect - Ed Sheeran",
    "Let Her Go - Passenger",
    "Photograph - Ed Sheeran",
    "Someone You Loved - Lewis Capaldi",
    "Arcade - Duncan Laurence",
  ];

  @override
  bool get wantKeepAlive => true;

  @override
  Widget build(BuildContext context) {
