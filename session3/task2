2.Create a simple Flutter app that displays your name and favorite food on the home screen, then run the app on your physical device using the 'flutter run' command.

import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: Scaffold(
        appBar: AppBar(
          title: const Text('My App'),
        ),
        body: const Center(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text('My Name: Riddhi'),
              Text('My Favorite Food: Pizza'),
            ],
          ),
        ),
      ),
    );
  }
}
