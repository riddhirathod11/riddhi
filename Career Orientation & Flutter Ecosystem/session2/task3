3.Build a simple Flipkart-style product listing screen using Flutter widgets: show a product image, name, price, and a Buy button in a Card widget.
Use a ListView to display at least three products.
import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: "Product App",
      home: const ProductScreen(),
    );
  }
}

