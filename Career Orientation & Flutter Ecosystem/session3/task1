1.Create a new Flutter app and replace the default home screen with a Scaffold containing a Column that displays two Text widgets 
showing your favorite food and favorite IPL team.

import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: Scaffold(
        appBar: AppBar(
          title: const Text("My Favorites"),
        ),
        body: const Column(
          children: [
            Text(
              "My Favorite Food: Pizza",
              style: TextStyle(
                fontSize: 22,
                fontWeight: FontWeight.bold,
              ),
            ),

            SizedBox(height: 20),

            Text(
              "My Favorite IPL Team: Chennai Super Kings",
              style: TextStyle(
                fontSize: 22,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
      ),
    );
  }
}
