              const SizedBox(height: 20),

              Image.network(
                'https://flutter.github.io/assets-for-api-docs/assets/widgets/owl.jpg',
                width: 200,
                height: 200,
                fit: BoxFit.cover,
                errorBuilder: (context, error, stackTrace) {
                  return const Text('Image could not be loaded');
                },
              ),
            ],
          ),
        ),
      ),
    );
  }
}
