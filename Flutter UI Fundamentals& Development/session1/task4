4.Create a new widget called UserGreeting in a separate Dart file, import it into main.dart, and use it inside your Scaffold’s body to display a message like 'Hello,
Flutter Learner!'.


import 'package:flutter/material.dart';
import 'user_greeting.dart';

void main() {
  runApp(
    const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: MyApp(),
    ),
  );
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('User Greeting'),
        backgroundColor: Colors.blue,
      ),
      body: const Center(
        child: UserGreeting(),
      ),
    );
  }
}


